# ---------------------------------------------------------------------------
# Kanzen environment
# Copy to .env for local development. On Vercel use `vercel env add`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Data stores
MONGODB_URI=mongodb://localhost:27017/kanzen
REDIS_URL=redis://localhost:6379

# Auth secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_32_byte_hex
JWT_REFRESH_SECRET=replace_with_another_32_byte_hex
# 32-byte hex key used to encrypt provider tokens at rest (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex

# Demo mode: when true, every provider serves fixture data and no real OAuth
# is required. Set to false to let visitors connect their own accounts, and set
# WEB_ORIGIN / API_PUBLIC_URL to the real deployment origin so redirects work.
PROVIDERS_DEMO_MODE=true

# Set to true only when a dedicated BullMQ worker is running (see render.yaml).
# When false, the API runs syncs inline in the request and no worker is needed.
WORKER_ENABLED=false

# Seeded demo account (created by `pnpm seed`)
DEMO_EMAIL=demo@kanzen.app
DEMO_PASSWORD=constellation

# AniList OAuth (https://anilist.co/settings/developer)
# Redirect URI must be: <API_PUBLIC_URL>/api/connections/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# MyAnimeList OAuth (https://myanimelist.net/apiconfig)
# App type "web", redirect URI: <API_PUBLIC_URL>/api/connections/mal/callback
# MAL only supports the "plain" PKCE method, which the connect route handles.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# TMDB (https://www.themoviedb.org/settings/api) - v4 read access token.
# Also used to enrich seed cover art. User auth is the v4 request-token flow;
# no redirect URI registration is required (it is passed as redirect_to).
TMDB_READ_TOKEN=

# Kitsu needs no app registration or env vars: it only supports a password
# grant, so users sign in with their own Kitsu email and password directly
# in the app (POST /api/connections/kitsu/credentials). The password is
# exchanged for a token once and never stored.

# Cron endpoint guard (Vercel cron sends this as a bearer token)
CRON_SECRET=replace_with_random_string

# Frontend (Vite) - only VITE_ prefixed vars are exposed to the browser
VITE_API_URL=http://localhost:4000
