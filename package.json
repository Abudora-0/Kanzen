{
  "name": "kanzen",
  "version": "0.1.0",
  "private": true,
  "description": "Unified media and cross-platform tracker dashboard for anime, manga, books, and movies.",
  "license": "MIT",
  "author": "Abudora-0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "predev": "pnpm --filter @kanzen/shared build && pnpm --filter @kanzen/providers build",
    "dev": "pnpm --parallel --filter \"@kanzen/shared\" --filter \"@kanzen/providers\" --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @kanzen/web dev",
    "dev:api": "pnpm --filter @kanzen/api dev",
    "dev:worker": "pnpm --filter @kanzen/worker dev",
    "build": "pnpm --filter @kanzen/shared build && pnpm --filter @kanzen/providers build && pnpm --filter @kanzen/web build && pnpm --filter @kanzen/api build && pnpm --filter @kanzen/worker build",
    "build:web": "pnpm --filter @kanzen/shared build && pnpm --filter @kanzen/providers build && pnpm --filter @kanzen/web build",
    "build:api": "pnpm --filter @kanzen/shared build && pnpm --filter @kanzen/providers build && pnpm --filter @kanzen/api build",
    "build:worker": "pnpm run build:api && pnpm --filter @kanzen/worker build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --filter \"@kanzen/*\" typecheck",
    "test": "pnpm -r --filter \"@kanzen/*\" test",
    "test:e2e": "pnpm --filter @kanzen/web test:e2e",
    "seed": "pnpm --filter @kanzen/api seed",
    "check:prose": "node scripts/no-em-dash.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@kanzen/api": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vercel/node": "^5.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,json,md,css,yml,yaml}": [
      "node scripts/no-em-dash.mjs --staged"
    ]
  }
}
